# Copy to .env and fill in as needed. All values are optional.

# Port the server listens on (default: 3000)
PORT=3000

# RAWG API key enables the "Search Online" cover art / metadata lookup.
# Without it the feature is disabled gracefully. Free key: https://rawg.io/apidocs
RAWG_API_KEY=

# Cross-origin access is OFF by default because the API is unauthenticated.
# Only set this if another origin must call the API; comma-separated, or "*".
# CORS_ORIGIN=https://games.example.com
